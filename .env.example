# 使用 `openssl rand -base64 48` 生成独立随机值后填写，不要提交真实密钥。
JWT_SECRET=

# Desktop/local production runtime. Keep this disabled in containers and public
# deployments; `npm run local:up` supplies it together with an absolute private
# APP_DATABASE_FILE path.
# GAMENOTE_LOCAL_RUNTIME=1
# APP_DATABASE_FILE=/absolute/private/gamenote/data/ns2.sqlite

# Nintendo read-only sidecar is server-only. Prefer the absolute 0600 secret
# file; the direct env value exists for secret-injection platforms only.
NINTENDO_SIDECAR_SOCKET_PATH=/run/nintendo-sidecar/sidecar.sock
NINTENDO_SIDECAR_API_KEY_FILE=/run/secrets/nintendo-sidecar-api-key
# NINTENDO_SIDECAR_API_KEY=

# The NS2 Docker image starts its bundled Moon service and uses /data/moon for
# private keys and encrypted authorization. See docs/container-runtime.md.
# MOON_AUTO_SYNC_ENABLED=1
# For a non-Docker standalone service, see docs/moon-runtime.md instead.

# Nintendo Store cumulative history uses independent authorization. The NS2
# image stores it in /data/nintendo-store and automatically syncs every 24 hours.
# NINTENDO_STORE_AUTO_SYNC_ENABLED=1

# 必填：固定到包含 Moon 与 Store 的个人 NS2 版本标签或 digest；不要使用上游镜像。
GAMENOTE_IMAGE=
