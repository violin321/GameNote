# 使用 `openssl rand -base64 48` 生成独立随机值后填写，不要提交真实密钥。
JWT_SECRET=

# 可选：自定义 Docker 镜像。
# GAMENOTE_IMAGE=dingding229/gamenote:latest

# Nintendo 数据源默认只允许手动同步。改为 1 后，GameNote 会分别按
# Moon 6 小时、Nintendo Store 24 小时的低频周期自动同步。
MOON_AUTO_SYNC_ENABLED=0
NINTENDO_STORE_AUTO_SYNC_ENABLED=0

# Moon 请求使用明确的 locale 与 IANA 时区，不继承服务器本地设置。
MOON_LOCALE=en-US
MOON_TIME_ZONE=UTC

# Moon API key、加密密钥、安装伪名密钥和 Nintendo Store session
# 均由当前部署在 data/private 下自行生成；不要在此文件填写或提交真实值。
