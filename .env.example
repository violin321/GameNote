# 使用 `openssl rand -base64 48` 生成独立随机值后填写，不要提交真实密钥。
JWT_SECRET=

# Desktop/local production runtime. Keep this disabled in containers and public
# deployments; `npm run local:up` supplies it together with an absolute private
# APP_DATABASE_FILE path.
# GAMENOTE_LOCAL_RUNTIME=1
# APP_DATABASE_FILE=/absolute/private/gamenote/data/ns2.sqlite

# Nintendo read-only sidecar is server-only. Prefer the absolute 0600 secret
# file; the direct env value exists for secret-injection platforms only.
NINTENDO_SIDECAR_SOCKET_PATH=/run/nintendo-sidecar/sidecar.sock
NINTENDO_SIDECAR_API_KEY_FILE=/run/secrets/nintendo-sidecar-api-key
# NINTENDO_SIDECAR_API_KEY=

# Moon / Nintendo Switch Parental Controls uses independent authorization.
# See docs/moon-connector.md. Keep real credentials outside this repository.
# MOON_SIDECAR_SOCKET_PATH=/absolute/private/gamenote-moon/run/sidecar.sock
# MOON_SIDECAR_API_KEY_FILE=/absolute/private/gamenote-moon/secrets/api-key
# Automatic sync is opt-in; do not also enable the sidecar scheduler.
# MOON_AUTO_SYNC_ENABLED=1
# MOON_SCHEDULER_STATE_FILE=/absolute/private/gamenote-moon/state/app-scheduler.sqlite

# Nintendo Store cumulative history sync is independent from Moon. It is
# intentionally low-frequency (once every 24 hours) and opt-in. The state file
# must be on a persistent private volume and must not be the application DB.
# NINTENDO_STORE_AUTO_SYNC_ENABLED=1
# NINTENDO_STORE_SCHEDULER_STATE_FILE=/absolute/private/gamenote-store/state/scheduler.sqlite

# 可选：固定到版本标签或提交标签，例如 dingding229/gamenote:1.0.0。
# GAMENOTE_IMAGE=dingding229/gamenote:latest
